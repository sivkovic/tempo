{
  "inputs": [
    {
      "id": "mapping",
      "schema": {
        "items": {
          "fields": [
            {
              "name": "sample",
              "type": "string"
            },
            {
              "name" :"num_fq_pairs",
              "type" :"number"
            },
            { "name": "target",
              "type": "string"
            },
            {
              "name": "fastq_pe1",
              "type": "File"
            },
            {
              "name": "fastq_pe2",
              "type": "File"
            }
          ],
          "type": "record"
        },
        "type": "array"
      },
      "template": "SAMPLE\tTARGET\tFASTQ_PE1\tFASTQ_PE2\tNUM_OF_PAIRS\n{{#mapping}}\n{{sample}}\t{{target}}\t{{fastq_pe1}}\t{{fastq_pe2}}\t{{num_fq_pairs}}\n{{/mapping}}"
    },
    {
      "id": "pairing",
      "schema": {
        "items": {
          "fields": [
            {
              "name": "tumor",
              "type": "string"
            },
            { 
              "name": "normal",
              "type": "string"
            }
          ],
          "type": "record"
        },
        "type": "array"
      },
      "template": "NORMAL_ID\tTUMOR_ID\n{{#pairing}}\n{{normal}}\t{{tumor}}\n{{/pairing}}"
    },
    {
      "id": "somatic",
      "schema": {
        "type": "bool"
      }
    },
        {
      "id": "aggregate",
      "schema": {
        "type": "bool"
      }
    }
  ],
  "outputs": [
    {
      "id": "outputs",
      "schema": {
        "type": {
          "items": "File",
          "type": "array"
        }
      }
    }
  ]
}
